# --- Cloud OpenAI (default if OPENAI_BASE_URL is empty) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_PLANNER_MODEL=gpt-4o

# --- Local Ollama (OpenAI-compatible API) — uncomment to avoid OpenAI billing ---
# Install https://ollama.com then: ollama pull qwen2.5:7b   (use exact name from: ollama list)
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=qwen2.5:7b
# OPENAI_PLANNER_MODEL=qwen2.5:7b

# Optional explicit API base (cloud); leave unset to use OpenAI default
# OPENAI_BASE_URL=https://api.openai.com/v1

# Kaggle — use ONE of:
# 1) ~/.kaggle/kaggle.json (classic username + key), or
# 2) New API token (Kaggle shows as KAGGLE_API_TOKEN). Scripts load .env via python-dotenv
#    inside tools/kaggle_utils before authenticate — put the line below in .env:
# KAGGLE_API_TOKEN=KGAT_your_token_here
# Legacy env (if you still use username/key instead of KGAT token):
# KAGGLE_USERNAME=
# KAGGLE_KEY=

COMPETITION_REF=mws-ai-agents-2026
WORKSPACE_ROOT=./workspace
# Явный путь к данным (если задан — игнорируется сборка из WORKSPACE_ROOT + slug):
# WORKSPACE_PATH=./workspace/mws-ai-agents-2026
RAG_VECTOR_STORE_PATH=./rag/kaggle_vector_store

# Planner passes (each pass can run one specialist). Keep small so the run finishes and actually submits.
MAX_WORKFLOW_ITERATIONS=10
# If submission.csv is still missing after this many planner steps, skip data_analytic/data_worker and run coder.
FORCE_CODER_MIN_PLANNER_ITERATION=3
CODE_EXECUTION_TIMEOUT=120
# Подробные логи (поток графа + agentic.* в консоли). По умолчанию включено. Выключить: 0/false
# WORKFLOW_VERBOSE=0

# RAG indexing example (rag/init.py) can use the same Ollama URL + model name for code descriptions
