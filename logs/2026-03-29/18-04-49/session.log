import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler, LabelEncoder
from sklearn.metrics import mean_squared_error
from sklearn.ensemble import RandomForestRegressor
import joblib
import json

# Load data
train_data = pd.read_csv('train.csv')
test_data = pd.read_csv('test.csv')

# Print shapes and memory usage
print("Train data shape:", train_data.shape)
print("Train data memory usage:\n", train_data.memory_usage(deep=True))
print("Test data shape:", test_data.shape)
print("Test data memory usage:\n", test_data.memory_usage(deep=True))

# Separate target column
X_train = train_data.drop('target', axis=1)
y_train = train_data['target']

# Handle missing values
numerical_cols = X_train.select_dtypes(include=['int64', 'float64']).columns
categorical_cols = X_train.select_dtypes(include=['object', 'category']).columns

for col in numerical_cols:
    median_val = X_train[col].median()
    X_train[col] = X_train[col].fillna(median_val)
    test_data[col] = test_data[col].fillna(median_val)

for col in categorical_cols:
    mode_val = X_train[col].mode()[0]
    X_train[col] = X_train[col].fillna(mode_val)
    test_data[col] = test_data[col].fillna(mode_val)

# Encode categorical columns
for col in categorical_cols:
    if X_train[col].nunique() > 50:
        freq_encoded = X_train.groupby(col).size() / len(X_train)
        X_train[col] = X_train[col].map(freq_encoded)
        test_data[col] = test_data[col].map(freq_encoded)
    else:
        le = LabelEncoder()
        X_train[col] = le.fit_transform(X_train[col])
        test_data[col] = le.transform(test_data[col])

# Scale numerical features
scaler = StandardScaler()
X_train[numerical_cols] = scaler.fit_transform(X_train[numerical_cols])
test_data[numerical_cols] = scaler.transform(test_data[numerical_cols])

# Train/val split
X_train, X_val, y_train, y_val = train_test_split(X_train, y_train, test_size=0.2, random_state=42)

# Train model
model = RandomForestRegressor(random_state=42)
model.fit(X_train, y_train.ravel())

# Predict on validation set
y_pred_val = model.predict(X_val)

# Calculate and print MSE score
mse_score = mean_squared_error(y_val, y_pred_val)
print(f"Validation MSE: {mse_score}")

# Save trained model
joblib.dump(model, 'model.pkl')

# Predict on test data
test_predictions = model.predict(test_data)

# Save predictions to CSV
predictions_df = pd.DataFrame({'index': test_data.index, 'prediction': test_predictions})
predictions_df.to_csv('predictions.csv', index=False)

# Print feature importance if applicable
if hasattr(model, 'feature_importances_'):
    importances = model.feature_importances_
    feature_names = X_train.columns
    feature_importance_df = pd.DataFrame({'feature': feature_names, 'importance': importances})
    print(feature_importance_df.sort_values(by='importance', ascending=False))

# Save scores to JSON
scores = {'validation_mse': mse_score}
with open('scores.json', 'w') as f:
    json.dump(scores, f)...
