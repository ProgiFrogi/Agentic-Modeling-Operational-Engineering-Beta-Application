location_cluster_df = pd.DataFrame(location_cluster_encoded, columns=encoder.get_feature_names_out(['location_cluster']))

df = df.join([type_house_df, location_cluster_df])
df.drop(columns=['type_house', 'location_cluster'], inplace=True)

