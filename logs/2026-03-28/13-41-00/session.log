import numpy as np
import os

# Load train.csv
train_df = pd.read_csv('data/train.csv')

# Check missing values and create binary features
train_df['is_last_dt_missing'] = train_df['last_dt'].isnull()
median_last_dt = pd.to_datetime(train_df[train_df['last_dt'].notnull()]['last_dt']).median()
train_df['last_dt'].fillna(median_last_dt, inplace=True)

train_df['is_avg_reviews_missing'] = train_df['avg_reviews'].isnull()
median_avg_reviews = train_df[train_df['avg_reviews'].notnull()]['avg_reviews'].median()
train_df['avg_reviews'].fillna(median_avg_reviews, inplace=True)

# Convert 'last_dt' to datetime and extract features
train_df['last_dt'] = pd.to_datetime(train_df['last_dt'])
train_df['year'] = train_df['last_dt'].dt.year
train_df['month'] = train_df['last_dt'].dt.month
train_df['day'] = train_df['last_dt'].dt.day
train_df['weekday'] = train_df['last_dt'].dt.weekday

# Check for outliers in 'sum' column using IQR method and cap the values
Q1 = train_df['sum'].quantile(0.25)
Q3 = train_df['sum'].quantile(0.75)
IQR = Q3 - Q1
train_df['sum'] = np.where(train_df['sum'] < (Q1 - 1.5 * IQR), (Q1 - 1.5 * IQR),
                          np.where(train_df['sum'] > (Q3 + 1.5 * IQR), (Q3 + 1.5 * IQR), train_df['sum']))

# Create new features
train_df['price_per_day'] = train_df['sum'] / train_df['min_days']
train_df['log_price_per_day'] = np.where(train_df['price_per_day'] > 0, np.log(train_df['price_per_day']), np.nan)

# One-hot encode categorical columns
categorical_columns = ['type_house', 'location_cluster']
train_df = pd.get_dummies(train_df, columns=categorical_columns)

# Save processed data to 'processed_data/processed_train.csv'
os.makedirs('processed_data', exist_ok=True)
train_df.to_csv('processed_data/processed_train.csv', index=False)

# Create output/analysis.txt with summary
with open('output/analysis.txt', 'w') as f:
    f.write("Data Processing Summary:\n")
    f.write(f"Original DataFrame Shape: {train_df.shape}\n")
    f.write("Missing Value Treatment:\n")
    f.write(f"  - 'last_dt': Median filled, {median_last_dt.strftime('%Y-%m-%d')}\n")
    f.write(f"  - 'avg_reviews': Median filled, {median_avg_reviews}\n")
    f.write("Date Features Extracted: year, month, day, weekday\n")
    f.write(f"IQR for 'sum' column:\n")
    f.write(f"  - Q1: {Q1}, Q3: {Q3}, IQR: {IQR}\n")
    f.write("New Features Created: price_per_day, log_price_per_day\n")
    f.write(f"Categorical Columns One-Hot Encoded: {', '.join(categorical_columns)}\n")
