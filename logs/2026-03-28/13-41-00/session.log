# Check missing values and fill them
median_last_dt = df['last_dt'].dropna().median()
df['is_last_dt_missing'] = df['last_dt'].isnull().astype(int)
df['last_dt'].fillna(median_last_dt, inplace=True)

median_avg_reviews = df['avg_reviews'].dropna().median()
df['is_avg_reviews_missing'] = df['avg_reviews'].isnull().astype(int)
df['avg_reviews'].fillna(median_avg_reviews, inplace=True)

# Convert 'last_dt' to datetime and extract features
df['last_dt'] = pd.to_datetime(df['last_dt'])
df['year'] = df['last_dt'].dt.year.fillna(0).astype(int)
df['month'] = df['last_dt'].dt.month.fillna(0).astype(int)
df['day'] = df['last_dt'].dt.day.fillna(0).astype(int)

# Check for outliers in 'sum' column using IQR method and cap them at the 99th percentile
Q1 = df['sum'].quantile(0.25)
Q3 = df['sum'].quantile(0.75)
IQR = Q3 - Q1
upper_bound = df['sum'].quantile(0.99)
df['sum'] = df['sum'].clip(upper=upper_bound)

# Feature engineering
df['price_per_day'] = df['sum'] / df['min_days']
df['review_rate'] = df['amt_reviews'] / df['sum']

