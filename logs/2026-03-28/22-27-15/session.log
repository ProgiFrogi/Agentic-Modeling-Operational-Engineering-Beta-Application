# Handle categoricals (frequency encoding for high cardinality)
for col in X.select_dtypes(['object']).columns:
    if X[col].nunique() > 50:
        freq = X_train[col].value_counts(normalize=True)
        X_train[col] = X_train[col].map(freq)
        X_val[col] = X_val[col].map(freq).fillna(0)
        test[col] = test[col].map(freq).fillna(0)
        print(f"Frequency encoded {col}")
    else:
        le = LabelEncoder()
        X_train[col] = le.fit_transform(X_train[col].astype(str))
        X_val[col] = le.transform(X_val[col].astype(str))
        test[col] = le.transform(test[col].astype(str))
        print(f"Label encoded {col}")

# Scale numerical
num_cols = X.select_dtypes(['int64', 'float64']).columns
if len(num_cols) > 0:
    scaler = StandardScaler()
    X_train[num_cols] = scaler.fit_transform(X_train[num_cols])
    X_val[num_cols] = scaler.transform(X_val[num_cols])
    test[num_cols] = scaler.transform(test[num_cols])
    print(f"Scaled {len(num_cols)} numerical features")

# Train model
model = GradientBoostingRegressor(
    max_depth=10, 
    n_estimators=100, 
    learning_rate=0.1, 
    random_state=42
)
