if len(num_cols) > 0:
    scaler = StandardScaler()
    X_train[num_cols] = scaler.fit_transform(X_train[num_cols])
    X_val[num_cols] = scaler.transform(X_val[num_cols])
    test[num_cols] = scaler.transform(test[num_cols])
    print(f"Scaled {len(num_cols)} numerical features")

# Train model
model = GradientBoostingRegressor(
    max_depth=10, 
    n_estimators=100, 
    learning_rate=0.1, 
    random_state=42
)
model.fit(X_train, y_train)
print("Model trained")

# Evaluate
y_pred = model.predict(X_val)
score = mean_squared_error(y_val, y_pred)
rmse = np.sqrt(score)
print(f"Validation MSE: {score:.6f}")
print(f"Validation RMSE: {rmse:.6f}")
print(f"Validation R2: {r2_score(y_val, y_pred):.6f}")

# Feature importance
if hasattr(model, 'feature_importances_'):
    importance = model.feature_importances_
    feat_imp = pd.DataFrame({'feature': X_train.columns, 'importance': importance})
    feat_imp = feat_imp.sort_values('importance', ascending=False).head(10)
    print("Top 10 feature importances:")
    print(feat_imp)

# Predict on test
test_pred = model.predict(test)
test_pred_df = pd.DataFrame({'prediction': test_pred})
test_pred_df.to_csv('predictions.csv', index=False)
print("Predictions saved to predictions.csv")

# Save model
joblib.dump(model, 'model.pkl')
print("Model saved to model.pkl")
