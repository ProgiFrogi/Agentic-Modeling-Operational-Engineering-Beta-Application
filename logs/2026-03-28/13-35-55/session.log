import numpy as np
from datetime import datetime

# Load train.csv
train_df = pd.read_csv('train.csv')

# Handle missing values
train_df['last_dt_missing'] = train_df['last_dt'].isnull().astype(int)
train_df['avg_reviews'].fillna(train_df['avg_reviews'].median(), inplace=True)

# Convert 'last_dt' to datetime if it contains date strings
try:
    train_df['last_dt'] = pd.to_datetime(train_df['last_dt'])
except ValueError:
    pass

# Handle outliers using IQR method
def handle_outliers(df, column, threshold=None):
    Q1 = df[column].quantile(0.25)
    Q3 = df[column].quantile(0.75)
    IQR = Q3 - Q1
    if threshold is not None:
        lower_bound, upper_bound = threshold
    else:
        lower_bound = Q1 - 1.5 * IQR
        upper_bound = Q3 + 1.5 * IQR
    return df[(df[column] >= lower_bound) & (df[column] <= upper_bound)]

train_df = handle_outliers(train_df, 'sum', threshold=(800, 1800))
train_df = handle_outliers(train_df, 'lat', threshold=(-90, 90))
train_df = handle_outliers(train_df, 'lon', threshold=(-180, 180))
train_df = handle_outliers(train_df, 'min_days', threshold=(0, 30))

# Feature engineering
train_df['price_per_day'] = np.where(train_df['min_days'] > 0, train_df['sum'] / train_df['min_days'], np.nan)
train_df['has_reviews'] = (train_df['amt_reviews'] > 0).astype(int)

current_date = datetime.now()
train_df['days_since_last_review'] = train_df.apply(lambda row: (current_date - row['last_dt']).days if pd.notnull(row['last_dt']) and not row['last_dt_missing'] else np.nan, axis=1)

# Drop columns that are not useful for modeling
columns_to_drop = ['_id', 'name', 'host_name', 'location', 'last_dt']
train_df.drop(columns=columns_to_drop, inplace=True)

# Save processed data to 'processed_data/processed_train.csv'
os.makedirs('processed_data', exist_ok=True)
train_df.to_csv('processed_data/processed_train.csv', index=False)

# Save any output/analysis to 'output/analysis.txt'
with open('output/analysis.txt', 'w') as f:
    f.write("Data processing completed successfully.\n")
    f.write(f"Rows before handling outliers: {len(train_df)}\n")
    f.write("Columns after feature engineering and dropping unnecessary columns:\n")
    f.write(", ".join(train_df.columns) + "\n")
