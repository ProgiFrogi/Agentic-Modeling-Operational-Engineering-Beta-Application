from sklearn.impute import SimpleImputer
from sklearn.preprocessing import StandardScaler, OneHotEncoder
from sklearn.compose import ColumnTransformer
from sklearn.pipeline import Pipeline

# Load data from session directory
train_df = pd.read_csv('train.csv')
test_df = pd.read_csv('test.csv')

# Function to perform EDA and preprocessing
def preprocess_data(df):
    # Check for missing values
    print("Missing values in the dataset:")
    print(df.isnull().sum())

    # Identify numerical and categorical columns
    numerical_cols = df.select_dtypes(include=['int64', 'float64']).columns.tolist()
    categorical_cols = df.select_dtypes(include=['object', 'category']).columns.tolist()

    # Handle missing values
    imputer_num = SimpleImputer(strategy='mean')
    imputer_cat = SimpleImputer(strategy='most_frequent')

    # Encode categorical variables
    encoder = OneHotEncoder(sparse_output=False)

    # Create a preprocessor
    preprocessor = ColumnTransformer(
        transformers=[
            ('num', imputer_num, numerical_cols),
            ('cat', Pipeline(steps=[('impute', imputer_cat), ('encode', encoder)]), categorical_cols)
        ])

    # Fit and transform the data
    df_processed = pd.DataFrame(preprocessor.fit_transform(df), columns=preprocessor.get_feature_names_out())
    
    return df_processed

# Preprocess train and test datasets
train_df_processed = preprocess_data(train_df)
test_df_processed = preprocess_data(test_df)

# Save processed data back to session directory
train_df_processed.to_csv('train.csv', index=False)
test_df_processed.to_csv('test.csv', index=False)
