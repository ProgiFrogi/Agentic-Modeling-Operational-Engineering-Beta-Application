from sklearn.preprocessing import StandardScaler, LabelEncoder, OneHotEncoder
from sklearn.impute import SimpleImputer
from sklearn.compose import ColumnTransformer
from sklearn.pipeline import Pipeline

# Load data from session directory
train_df = pd.read_csv('train.csv')
test_df = pd.read_csv('test.csv')

print("Train DataFrame shape:", train_df.shape)
print("Test DataFrame shape:", test_df.shape)

# Check for missing values
print("\nMissing values in Train DataFrame:")
print(train_df.isnull().sum())

print("\nMissing values in Test DataFrame:")
print(test_df.isnull().sum())

# Identify numerical and categorical columns
numerical_cols = train_df.select_dtypes(include=['int64', 'float64']).columns.tolist()
categorical_cols = train_df.select_dtypes(include=['object', 'category']).columns.tolist()

# Handle missing values
num_imputer = SimpleImputer(strategy='median')
cat_imputer = SimpleImputer(strategy='most_frequent')

train_df[numerical_cols] = num_imputer.fit_transform(train_df[numerical_cols])
test_df[numerical_cols] = num_imputer.transform(test_df[numerical_cols])

train_df[categorical_cols] = cat_imputer.fit_transform(train_df[categorical_cols])
test_df[categorical_cols] = cat_imputer.transform(test_df[categorical_cols])

# Encode categorical variables
label_encoders = {}
one_hot_encoders = {}

for col in categorical_cols:
    if train_df[col].nunique() <= 50:
        le = LabelEncoder()
        train_df[col] = le.fit_transform(train_df[col])
        test_df[col] = le.transform(test_df[col])
        label_encoders[col] = le
    else:
        ohe = OneHotEncoder(sparse_output=False)
        train_ohe = ohe.fit_transform(train_df[[col]])
        test_ohe = ohe.transform(test_df[[col]])
        
        # Create new columns for one-hot encoded features
        ohe_feature_names = [f"{col}_{cat}" for cat in ohe.categories_[0]]
        train_df[ohe_feature_names] = train_ohe
        test_df[ohe_feature_names] = test_ohe
        
        # Drop the original categorical column
        train_df.drop(columns=[col], inplace=True)
        test_df.drop(columns=[col], inplace=True)
        
        one_hot_encoders[col] = ohe

# Normalize numerical features
scaler = StandardScaler()
train_df[numerical_cols] = scaler.fit_transform(train_df[numerical_cols])
test_df[numerical_cols] = scaler.transform(test_df[numerical_cols])

# Save processed data back to the same files (overwrite)
train_df.to_csv('train.csv', index=False)
test_df.to_csv('test.csv', index=False)

print("\nProcessed Train DataFrame shape:", train_df.shape)
print("Processed Test DataFrame shape:", test_df.shape)
print("Memory usage of Processed Train DataFrame:")
print(train_df.memory_usage(deep=True).sum())
print("Memory usage of Processed Test DataFrame:")
print(test_df.memory_usage(deep=True).sum())

print("\nData processing complete.")
