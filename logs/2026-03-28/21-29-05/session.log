        le = LabelEncoder()
        train_df[col] = le.fit_transform(train_df[col])
        test_df[col] = le.transform(test_df[col])
        label_encoders[col] = le
    else:
        ohe = OneHotEncoder(sparse_output=False)
        train_ohe = ohe.fit_transform(train_df[[col]])
        test_ohe = ohe.transform(test_df[[col]])
        
        # Create new columns for one-hot encoded features
        ohe_feature_names = [f"{col}_{cat}" for cat in ohe.categories_[0]]
        train_df[ohe_feature_names] = train_ohe
        test_df[ohe_feature_names] = test_ohe
        
        # Drop the original categorical column
        train_df.drop(columns=[col], inplace=True)
        test_df.drop(columns=[col], inplace=True)
        
        one_hot_encoders[col] = ohe

# Normalize numerical features
scaler = StandardScaler()
train_df[numerical_cols] = scaler.fit_transform(train_df[numerical_cols])
test_df[numerical_cols] = scaler.transform(test_df[numerical_cols])

