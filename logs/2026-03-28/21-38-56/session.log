from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler, OneHotEncoder, LabelEncoder
from sklearn.impute import SimpleImputer

# Load data
train_df = pd.read_csv('train.csv')
test_df = pd.read_csv('test.csv')

# Check data types
print("Train DataFrame dtypes:")
print(train_df.dtypes)
print("\nTest DataFrame dtypes:")
print(test_df.dtypes)

# Identify and correct discrepancies in data types
for col in train_df.columns:
    if col in test_df.columns:
        if train_df[col].dtype != test_df[col].dtype:
            print(f"Data type mismatch for column {col}: Train is {train_df[col].dtype}, Test is {test_df[col].dtype}")
            # Convert to the same data type
            dtype = train_df[col].dtype if train_df[col].dtype == 'float64' else test_df[col].dtype
            train_df[col] = train_df[col].astype(dtype)
            test_df[col] = test_df[col].astype(dtype)

# Check for missing values and handle them
def handle_missing_values(df):
    numerical_cols = df.select_dtypes(include=['number']).columns
    categorical_cols = df.select_dtypes(include=['object', 'category']).columns
    
    # Impute numerical columns with median
    num_imputer = SimpleImputer(strategy='median')
    df[numerical_cols] = num_imputer.fit_transform(df[numerical_cols])
    
    # Impute categorical columns with mode
    cat_imputer = SimpleImputer(strategy='most_frequent')
    df[categorical_cols] = cat_imputer.fit_transform(df[categorical_cols])
    
    return df

train_df = handle_missing_values(train_df)
test_df = handle_missing_values(test_df)

# Ensure 'target' column in train.csv is correctly labeled
if 'target' in train_df.columns:
    train_df['target'] = pd.to_numeric(train_df['target'], errors='coerce')
    train_df.dropna(subset=['target'], inplace=True)

# Normalize or standardize numerical features
numerical_cols_train = [c for c in train_df.select_dtypes(include=['number']).columns if c != 'target']
scaler = StandardScaler()
train_df[numerical_cols_train] = scaler.fit_transform(train_df[numerical_cols_train])
test_df[numerical_cols_train] = scaler.transform(test_df[numerical_cols_train])

# Encode categorical variables
def encode_categorical(df):
    categorical_cols = df.select_dtypes(include=['object', 'category']).columns
    for col in categorical_cols:
        if df[col].nunique() > 50:
            # Use label encoding for high-cardinality columns
            le = LabelEncoder()
            df[col] = le.fit_transform(df[col])
        else:
            # Use one-hot encoding for low-cardinality columns
            ohe = OneHotEncoder(sparse_output=False)
            encoded_cols = ohe.fit_transform(df[[col]])
            encoded_df = pd.DataFrame(encoded_cols, columns=ohe.get_feature_names_out([col]))
            df = pd.concat([df.drop(columns=[col]), encoded_df], axis=1)
    return df

train_df = encode_categorical(train_df)
test_df = encode_categorical(test_df)

# Split the training data into training and validation sets
X_train, X_val, y_train, y_val = train_test_split(train_df.drop(columns=['target']), train_df['target'], test_size=0.2, random_state=42)

# Save processed data back to the same files
train_df.to_csv('train.csv', index=False)
test_df.to_csv('test.csv', index=False)

# Print shapes and memory usage after operations
print("\nTrain DataFrame shape:", train_df.shape)
print("Train DataFrame memory usage:", train_df.memory_usage(deep=True).sum() / 1024**2, "MB")
print("\nTest DataFrame shape:", test_df.shape)
print("Test DataFrame memory usage:", test_df.memory_usage(deep=True).sum() / 1024**2, "MB")

# Print progress messages
print("\nData processing complete.")
