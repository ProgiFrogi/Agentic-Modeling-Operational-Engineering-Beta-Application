from sklearn.preprocessing import StandardScaler, OneHotEncoder, LabelEncoder
from sklearn.impute import SimpleImputer
from sklearn.compose import ColumnTransformer
from sklearn.pipeline import Pipeline

# Load data
train_df = pd.read_csv('train.csv')
test_df = pd.read_csv('test.csv')

# Verify consistent data types
print("Train DataFrame info:")
print(train_df.info())
print("\nTest DataFrame info:")
print(test_df.info())

# Check for missing values
print("\nMissing values in train.csv:")
print(train_df.isnull().sum())
print("\nMissing values in test.csv:")
print(test_df.isnull().sum())

# Ensure 'target' column is correctly labeled and contains valid numerical values
if not pd.api.types.is_numeric_dtype(train_df['target']):
    raise ValueError("Target column must contain numeric values")

# Identify numerical and categorical columns
numerical_cols = train_df.select_dtypes(include=['int64', 'float64']).columns.tolist()
categorical_cols = train_df.select_dtypes(include=['object', 'category']).columns.tolist()

# Handle missing values
numerical_imputer = SimpleImputer(strategy='median')
categorical_imputer = SimpleImputer(strategy='most_frequent')

# Encode categorical variables
high_cardinality_threshold = 50

for col in categorical_cols:
    if train_df[col].nunique() > high_cardinality_threshold:
        # Use Label Encoding for high-cardinality columns
        le = LabelEncoder()
        train_df[col] = le.fit_transform(train_df[col])
        test_df[col] = le.transform(test_df[col])
    else:
        # Use OneHotEncoding for low-cardinality columns
        ohe = OneHotEncoder(sparse_output=False)
        train_encoded = ohe.fit_transform(train_df[[col]])
        test_encoded = ohe.transform(test_df[[col]])
        
        # Create new DataFrame with encoded features
        train_encoded_df = pd.DataFrame(train_encoded, columns=ohe.get_feature_names_out([col]))
        test_encoded_df = pd.DataFrame(test_encoded, columns=ohe.get_feature_names_out([col]))
        
        # Drop original column and concatenate encoded features
        train_df = pd.concat([train_df.drop(columns=[col]), train_encoded_df], axis=1)
        test_df = pd.concat([test_df.drop(columns=[col]), test_encoded_df], axis=1)

# Normalize numerical features
scaler = StandardScaler()
numerical_cols_train = [c for c in numerical_cols if c != 'target']
train_df[numerical_cols_train] = scaler.fit_transform(train_df[numerical_cols_train])
test_df[numerical_cols_train] = scaler.transform(test_df[numerical_cols_train])

# Split the training data into training and validation sets
X_train, X_val, y_train, y_val = train_test_split(train_df.drop(columns=['target']), train_df['target'], test_size=0.2, random_state=42)

# Save processed data back to the same files (overwrite)
train_df.to_csv('train.csv', index=False)
test_df.to_csv('test.csv', index=False)

# Print shapes and memory usage after operations
print("\nTrain DataFrame shape:", train_df.shape)
print("Train DataFrame memory usage:")
print(train_df.memory_usage(deep=True))
print("\nTest DataFrame shape:", test_df.shape)
print("Test DataFrame memory usage:")
print(test_df.memory_usage(deep=True))

print("\nTraining set shape:", X_train.shape, y_train.shape)
print("Validation set shape:", X_val.shape, y_val.shape)

print("\nProcessing complete.")
