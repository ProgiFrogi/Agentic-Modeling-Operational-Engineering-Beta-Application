from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler, OneHotEncoder, LabelEncoder
from sklearn.impute import SimpleImputer
from sklearn.compose import ColumnTransformer
from sklearn.pipeline import Pipeline

# Load data
train_df = pd.read_csv('train.csv')
test_df = pd.read_csv('test.csv')

# Print initial shapes and memory usage
print("Initial train shape:", train_df.shape)
print("Initial test shape:", test_df.shape)
print("Train memory usage:\n", train_df.memory_usage(deep=True))
print("Test memory usage:\n", test_df.memory_usage(deep=True))

# Verify consistent data types
train_dtypes = train_df.dtypes
test_dtypes = test_df.dtypes

if not train_dtypes.equals(test_dtypes):
    raise ValueError("Data types are inconsistent between train and test datasets.")

# Check for missing values
print("\nMissing values in train:\n", train_df.isnull().sum())
print("\nMissing values in test:\n", test_df.isnull().sum())

# Ensure 'target' column is correctly labeled and contains valid numerical values
if not pd.api.types.is_numeric_dtype(train_df['target']):
    raise ValueError("'target' column must contain numerical values.")

# Identify numerical and categorical columns
numerical_cols = train_df.select_dtypes(include=['int64', 'float64']).columns.tolist()
categorical_cols = train_df.select_dtypes(include=['object', 'category']).columns.tolist()

# Handle missing values
numerical_imputer = SimpleImputer(strategy='median')
categorical_imputer = SimpleImputer(strategy='most_frequent')

# Encode categorical variables
label_encoders = {}
for col in categorical_cols:
    le = LabelEncoder()
    train_df[col] = le.fit_transform(train_df[col])
    test_df[col] = le.transform(test_df[col])
    label_encoders[col] = le

# Normalize numerical features
scaler = StandardScaler()

# Create preprocessing pipeline for train data
preprocessor_train = ColumnTransformer(
    transformers=[
        ('num', scaler, numerical_cols),
        ('cat', 'passthrough', categorical_cols)
    ])

# Create preprocessing pipeline for test data (excluding 'target')
numerical_cols_test = [c for c in numerical_cols if c != 'target']
preprocessor_test = ColumnTransformer(
    transformers=[
        ('num', scaler, numerical_cols_test),
        ('cat', 'passthrough', categorical_cols)
    ])

# Fit and transform train data
train_df_processed = preprocessor_train.fit_transform(train_df.drop(columns=['target']), train_df['target'])
train_df_processed = pd.DataFrame(train_df_processed, columns=numerical_cols + categorical_cols)

# Transform test data
test_df_processed = preprocessor_test.transform(test_df)
test_df_processed = pd.DataFrame(test_df_processed, columns=numerical_cols_test + categorical_cols)

# Split the training data into training and validation sets
X_train, X_val, y_train, y_val = train_test_split(train_df.drop(columns=['target']), train_df['target'], test_size=0.2, random_state=42)

# Print shapes and memory usage after processing
print("\nProcessed train shape:", train_df_processed.shape)
print("Processed test shape:", test_df_processed.shape)
print("Processed train memory usage:\n", train_df_processed.memory_usage(deep=True))
print("Processed test memory usage:\n", test_df_processed.memory_usage(deep=True))

# Save processed data back to the same files
train_df.to_csv('train.csv', index=False)
test_df.to_csv('test.csv', index=False)

# Print progress messages
print("\nData processing complete. Files saved.")
