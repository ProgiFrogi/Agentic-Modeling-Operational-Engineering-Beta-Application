from sklearn.preprocessing import LabelEncoder, StandardScaler

# Load data from session directory
train_df = pd.read_csv('train.csv')
test_df = pd.read_csv('test.csv')

# Check data types of all columns in both datasets
print("Train DataFrame Data Types:")
print(train_df.dtypes)
print("\nTest DataFrame Data Types:")
print(test_df.dtypes)

# Identify discrepancies and ensure consistency between the two datasets

# Handle missing values
numerical_cols_train = [c for c in train_df.columns if train_df[c].dtype != 'object' and c != 'target']
categorical_cols_train = [c for c in train_df.columns if train_df[c].dtype == 'object']

for col in numerical_cols_train:
    median_value = train_df[col].median()
    train_df[col] = train_df[col].fillna(median_value)
    test_df[col] = test_df[col].fillna(median_value)

for col in categorical_cols_train:
    mode_value = train_df[col].mode()[0]
    train_df[col] = train_df[col].fillna(mode_value)
    test_df[col] = test_df[col].fillna(mode_value)

# Handle high-cardinality columns
high_cardinality_cols = [col for col in categorical_cols_train if train_df[col].nunique() > 50]

for col in high_cardinality_cols:
    # Using Label Encoding for simplicity
    le = LabelEncoder()
    train_df[col] = le.fit_transform(train_df[col])
    test_df[col] = le.transform(test_df[col])

# Standardize numerical features
scaler = StandardScaler()
train_df[numerical_cols_train] = scaler.fit_transform(train_df[numerical_cols_train])
test_df[numerical_cols_train] = scaler.transform(test_df[numerical_cols_train])

# Save the processed data back to the same files (overwrite)
train_df.to_csv('train.csv', index=False)
test_df.to_csv('test.csv', index=False)

print("Data processing complete. Files saved.")
