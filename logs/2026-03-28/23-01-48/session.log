from sklearn.model_selection import train_test_split, cross_val_score
from sklearn.ensemble import GradientBoostingRegressor
from sklearn.metrics import mean_squared_error
from sklearn.preprocessing import StandardScaler, OneHotEncoder
from sklearn.impute import SimpleImputer
from sklearn.compose import ColumnTransformer
from sklearn.pipeline import Pipeline
import joblib

# Load data
train_data = pd.read_csv('train.csv')
test_data = pd.read_csv('test.csv')

# Print shapes and memory usage
print("Train Data Shape:", train_data.shape)
print("Train Data Memory Usage:\n", train_data.memory_usage(deep=True))
print("Test Data Shape:", test_data.shape)
print("Test Data Memory Usage:\n", test_data.memory_usage(deep=True))

# Separate target and features
X_train = train_data.drop(columns=['target'])
y_train = train_data['target']

# Identify numerical and categorical columns
numerical_cols = X_train.select_dtypes(include=['int64', 'float64']).columns.tolist()
categorical_cols = X_train.select_dtypes(include=['object', 'category']).columns.tolist()

# Handle missing values
numerical_imputer = SimpleImputer(strategy='median')
categorical_imputer = SimpleImputer(strategy='most_frequent')

# Preprocessing for numerical features
numerical_transformer = Pipeline(steps=[
    ('imputer', numerical_imputer),
    ('scaler', StandardScaler())
])

# Preprocessing for categorical features
def encode_column(column):
    if column.nunique() > 50:
        return 'frequency'
    else:
        return 'label'

categorical_transformers = []
for col in categorical_cols:
    encoding_type = encode_column(X_train[col])
    if encoding_type == 'frequency':
        freq_encoded = X_train.groupby(col).size() / len(X_train)
        X_train[col] = X_train[col].map(freq_encoded)
        test_data[col] = test_data[col].map(freq_encoded.fillna(0))
    else:
        encoder = OneHotEncoder(sparse_output=False, handle_unknown='ignore')
        categorical_transformers.append((col, encoder))

# Combine transformers
preprocessor = ColumnTransformer(
    transformers=[
        ('num', numerical_transformer, numerical_cols),
        *categorical_transformers
    ]
)

# Create model pipeline
model = GradientBoostingRegressor(
    max_depth=10,
    n_estimators=100,
    learning_rate=0.1,
    random_state=42
)

pipeline = Pipeline(steps=[
    ('preprocessor', preprocessor),
    ('regressor', model)
])

# Train the model
print("Training the model...")
pipeline.fit(X_train, y_train)

# Save the trained model
joblib.dump(pipeline, 'model.pkl')
print("Model saved to 'model.pkl'")

# Make predictions on test data
test_predictions = pipeline.predict(test_data)

# Save predictions to CSV
pd.DataFrame({'predictions': test_predictions}).to_csv('predictions.csv', index=False)
print("Predictions saved to 'predictions.csv'")

# Evaluate the model on validation set
X_train, X_val, y_train, y_val = train_test_split(X_train, y_train, test_size=0.2, random_state=42)

val_predictions = pipeline.predict(X_val)
mse = mean_squared_error(y_val, val_predictions)
print(f"Validation MSE: {mse}")

# Print feature importance
if hasattr(model, 'feature_importances_'):
    importances = model.feature_importances_
    feature_names = numerical_cols + [col for transformer in categorical_transformers for col in transformer[1].get_feature_names_out()]
    feature_importance_df = pd.DataFrame({'Feature': feature_names, 'Importance': importances})
    print("Feature Importances:\n", feature_importance_df.sort_values(by='Importance', ascending=False))
else:
    print("Model does not have feature importance attribute.")
