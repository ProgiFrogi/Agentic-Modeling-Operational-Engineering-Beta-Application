from sklearn.model_selection import train_test_split, cross_val_score
from sklearn.ensemble import GradientBoostingRegressor
from sklearn.metrics import mean_squared_error
from sklearn.preprocessing import StandardScaler, OneHotEncoder, LabelEncoder
from sklearn.impute import SimpleImputer
from sklearn.compose import ColumnTransformer
from sklearn.pipeline import Pipeline
import joblib

# Load data
train_data = pd.read_csv('train.csv')
test_data = pd.read_csv('test.csv')

# Print initial shapes and memory usage
print("Train Data Shape:", train_data.shape)
print("Test Data Shape:", test_data.shape)
print("Train Data Memory Usage:\n", train_data.memory_usage(deep=True))
print("Test Data Memory Usage:\n", test_data.memory_usage(deep=True))

# Handle missing values
numerical_cols = train_data.select_dtypes(include=['number']).columns.tolist()
categorical_cols = train_data.select_dtypes(include=['object', 'category']).columns.tolist()

# Fill numerical missing values with median
num_imputer = SimpleImputer(strategy='median')
train_data[numerical_cols] = num_imputer.fit_transform(train_data[numerical_cols])
test_data[numerical_cols] = num_imputer.transform(test_data[numerical_cols])

# Fill categorical missing values with mode
cat_imputer = SimpleImputer(strategy='most_frequent')
train_data[categorical_cols] = cat_imputer.fit_transform(train_data[categorical_cols])
test_data[categorical_cols] = cat_imputer.transform(test_data[categorical_cols])

# Handle high cardinality categorical features
high_cardinality_cols = [col for col in categorical_cols if train_data[col].nunique() > 50]

# Frequency encoding for high cardinality columns
for col in high_cardinality_cols:
    freq_encoded = train_data.groupby(col).size() / len(train_data)
    train_data[col] = train_data[col].map(freq_encoded)
    test_data[col] = test_data[col].map(freq_encoded.fillna(0))

# Label encoding for remaining categorical columns
label_encoders = {}
for col in set(categorical_cols) - set(high_cardinality_cols):
    le = LabelEncoder()
    train_data[col] = le.fit_transform(train_data[col])
    test_data[col] = le.transform(test_data[col])
    label_encoders[col] = le

# Print shapes and memory usage after handling missing values
print("Train Data Shape after Missing Value Handling:", train_data.shape)
print("Test Data Shape after Missing Value Handling:", test_data.shape)
print("Train Data Memory Usage after Missing Value Handling:\n", train_data.memory_usage(deep=True))
print("Test Data Memory Usage after Missing Value Handling:\n", test_data.memory_usage(deep=True))

# Define preprocessing steps
numerical_transformer = Pipeline(steps=[
    ('scaler', StandardScaler())
])

categorical_transformer = Pipeline(steps=[
    ('onehot', OneHotEncoder(handle_unknown='ignore', sparse_output=False))
])

preprocessor = ColumnTransformer(
    transformers=[
        ('num', numerical_transformer, numerical_cols),
        ('cat', categorical_transformer, set(categorical_cols) - set(high_cardinality_cols))
    ])

# Define model
model = GradientBoostingRegressor(max_depth=10, n_estimators=100, learning_rate=0.1, random_state=42)

# Create full pipeline
full_pipeline = Pipeline(steps=[('preprocessor', preprocessor),
                                ('regressor', model)])

# Split data into train and validation sets
X_train, X_val, y_train, y_val = train_test_split(train_data.drop(columns=['target']), train_data['target'], test_size=0.2, random_state=42)

# Train the model
full_pipeline.fit(X_train, y_train.ravel())

# Make predictions on validation set
y_pred_val = full_pipeline.predict(X_val)
mse_val = mean_squared_error(y_val, y_pred_val)
print("Validation MSE:", mse_val)

# Save trained model
joblib.dump(full_pipeline, 'model.pkl')

# Make predictions on test data
test_predictions = full_pipeline.predict(test_data)
predictions_df = pd.DataFrame({'id': test_data.index, 'target': test_predictions})
predictions_df.to_csv('predictions.csv', index=False)

# Print feature importance if applicable
if hasattr(model, 'feature_importances_'):
    feature_importance = model.feature_importances_
    features = full_pipeline.named_steps['preprocessor'].transformers_[0][1].named_steps['scaler'].get_feature_names_out(numerical_cols) \
                + full_pipeline.named_steps['preprocessor'].transformers_[1][1].named_steps['onehot'].get_feature_names_out(set(categorical_cols) - set(high_cardinality_cols))
    feature_importance_df = pd.DataFrame({'feature': features, 'importance': feature_importance})
    print("Feature Importance:\n", feature_importance_df.sort_values(by='importance', ascending=False))

# Print shapes and memory usage after processing
print("Train Data Shape after Processing:", train_data.shape)
print("Test Data Shape after Processing:", test_data.shape)
print("Train Data Memory Usage after Processing:\n", train_data.memory_usage(deep=True))
print("Test Data Memory Usage after Processing:\n", test_data.memory_usage(deep=True))
