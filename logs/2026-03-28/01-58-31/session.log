print("Missing Values:\n", missing_values)

# Handle missing values
train_df.drop(columns=['last_dt'], inplace=True)
median_avg_reviews = train_df['avg_reviews'].median()
train_df['avg_reviews'].fillna(median_avg_reviews, inplace=True)

# Check data types
print("\nData Types:\n", train_df.dtypes)

# Analyze target distribution
import matplotlib.pyplot as plt
plt.hist(train_df['target'], bins=50)
plt.title('Target Distribution')
plt.xlabel('Target')
plt.ylabel('Frequency')
plt.show()

# Analyze feature correlations
correlation_matrix = train_df.corr()
print("\nFeature Correlations:\n", correlation_matrix)

# Analyze feature distributions
for col in ['sum', 'min_days', 'amt_reviews']:
    plt.hist(train_df[col], bins=50)
    plt.title(f'Distribution of {col}')
    plt.xlabel(col)
    plt.ylabel('Frequency')
    plt.show()

# Handle outliers
Q1 = train_df.quantile(0.25)
Q3 = train_df.quantile(0.75)
IQR = Q3 - Q1

outlier_conditions = {
    'sum': (train_df['sum'] < 0) | (train_df['sum'] > 750000),
    'min_days': (train_df['min_days'] < 0) | (train_df['min_days'] > 90),
    'amt_reviews': (train_df['amt_reviews'] < 0) | (train_df['amt_reviews'] > 2500),
    'avg_reviews': (train_df['avg_reviews'] < 0) | (train_df['avg_reviews'] > 25),
    'total_host': (train_df['total_host'] < 0) | (train_df['total_host'] > 400),
    'target': (train_df['target'] < 0) | (train_df['target'] > 250)
}

for col, condition in outlier_conditions.items():
    train_df = train_df[~condition]

# Feature engineering
train_df['price_per_day'] = np.where(train_df['min_days'] == 0, np.nan, train_df['sum'] / train_df['min_days'])
median_price_per_day = train_df['price_per_day'].median()
train_df['price_per_day'].fillna(median_price_per_day, inplace=True)

train_df['review_rate'] = np.where(train_df['total_host'] == 0, np.nan, train_df['amt_reviews'] / train_df['total_host'])
mean_review_rate = train_df['review_rate'].mean()
train_df['review_rate'].fillna(mean_review_rate, inplace=True)

# One-hot encoding for categorical features
train_df = pd.get_dummies(train_df, columns=['location_cluster', 'location'])

# Convert 'host_name' to categorical features using one-hot encoding
train_df = pd.get_dummies(train_df, columns=['host_name'])

# Save processed data
train_df.to_csv('data/processed_train.csv', index=False)
