encoder = OneHotEncoder(sparse=False, drop='first')
encoded_features = encoder.fit_transform(train_df[categorical_features])
encoded_df = pd.DataFrame(encoded_features, columns=encoder.get_feature_names_out(categorical_features))
train_df = pd.concat([train_df.drop(columns=categorical_features), encoded_df], axis=1)

# Normalize or standardize numerical features
scaler = StandardScaler()
numerical_features = train_df.select_dtypes(include=['float64', 'int64']).columns
train_df[numerical_features] = scaler.fit_transform(train_df[numerical_features])

# Display the processed dataset
print(train_df.head())
