print("Missing Values:\n", missing_values)

# Handle missing values in 'last_dt' and 'avg_reviews'
imputer_last_dt = SimpleImputer(strategy='most_frequent')
train_df['last_dt'] = imputer_last_dt.fit_transform(train_df[['last_dt']])

imputer_avg_reviews = SimpleImputer(strategy='mean')
