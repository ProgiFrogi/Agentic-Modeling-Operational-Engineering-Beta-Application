from sklearn.preprocessing import StandardScaler, LabelEncoder
from sklearn.impute import SimpleImputer

# Load data
train_df = pd.read_csv('train.csv')
test_df = pd.read_csv('test.csv')

print("Train shape:", train_df.shape)
print("Test shape:", test_df.shape)

# Identify numerical and categorical columns
numerical_cols_train = [c for c in train_df.columns if train_df[c].dtype in ['int64', 'float64'] and c != 'target']
categorical_cols_train = [c for c in train_df.columns if train_df[c].dtype == 'object' and c != 'target']

numerical_cols_test = [c for c in test_df.columns if test_df[c].dtype in ['int64', 'float64']]
categorical_cols_test = [c for c in test_df.columns if test_df[c].dtype == 'object']

# Handle missing values
print("Handling missing values...")

# Numerical columns
imputer_num_train = SimpleImputer(strategy='median')
train_df[numerical_cols_train] = imputer_num_train.fit_transform(train_df[numerical_cols_train])

imputer_num_test = SimpleImputer(strategy='median')
test_df[numerical_cols_test] = imputer_num_test.fit_transform(test_df[numerical_cols_test])

# Categorical columns
imputer_cat_train = SimpleImputer(strategy='most_frequent')
train_df[categorical_cols_train] = imputer_cat_train.fit_transform(train_df[categorical_cols_train])

imputer_cat_test = SimpleImputer(strategy='most_frequent')
test_df[categorical_cols_test] = imputer_cat_test.fit_transform(test_df[categorical_cols_test])

print("Missing values handled.")

# Feature engineering for datetime columns
for col in train_df.columns:
    if pd.api.types.is_datetime64_any_dtype(train_df[col]):
        train_df[f'{col}_year'] = train_df[col].dt.year
        train_df[f'{col}_month'] = train_df[col].dt.month
        train_df[f'{col}_day'] = train_df[col].dt.day
        train_df[f'{col}_dayofweek'] = train_df[col].dt.dayofweek

for col in test_df.columns:
    if pd.api.types.is_datetime64_any_dtype(test_df[col]):
        test_df[f'{col}_year'] = test_df[col].dt.year
        test_df[f'{col}_month'] = test_df[col].dt.month
        test_df[f'{col}_day'] = test_df[col].dt.day
        test_df[f'{col}_dayofweek'] = test_df[col].dt.dayofweek

print("Datetime features extracted.")

# Encoding categorical columns
label_encoders = {}
for col in categorical_cols_train:
    le = LabelEncoder()
    train_df[col] = le.fit_transform(train_df[col])
    label_encoders[col] = le

for col in categorical_cols_test:
    if col in label_encoders:
        test_df[col] = label_encoders[col].transform(test_df[col])

print("Categorical columns encoded.")

# Standardize numerical features
scaler = StandardScaler()
train_df[numerical_cols_train] = scaler.fit_transform(train_df[numerical_cols_train])
test_df[numerical_cols_test] = scaler.transform(test_df[numerical_cols_test])

print("Numerical features standardized.")

# Save processed data back to files
train_df.to_csv('train.csv', index=False)
test_df.to_csv('test.csv', index=False)

print("Processed data saved.")
