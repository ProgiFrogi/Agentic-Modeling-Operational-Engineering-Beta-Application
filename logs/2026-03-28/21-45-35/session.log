from sklearn.impute import SimpleImputer
from sklearn.preprocessing import StandardScaler, LabelEncoder

# Load data from session directory
train_df = pd.read_csv('train.csv')
test_df = pd.read_csv('test.csv')

# Print initial shapes and memory usage
print("Initial Train Shape:", train_df.shape)
print("Initial Test Shape:", test_df.shape)
print("Train Memory Usage:\n", train_df.memory_usage(deep=True))
print("Test Memory Usage:\n", test_df.memory_usage(deep=True))

# Verify columns presence and correctness
required_columns_train = ['feature1', 'feature2', 'target']  # Replace with actual required columns
required_columns_test = ['feature1', 'feature2']  # Replace with actual required columns

missing_cols_train = set(required_columns_train) - set(train_df.columns)
missing_cols_test = set(required_columns_test) - set(test_df.columns)

if missing_cols_train:
    raise ValueError(f"Missing columns in train.csv: {missing_cols_train}")
if missing_cols_test:
    raise ValueError(f"Missing columns in test.csv: {missing_cols_test}")

# Check for missing values and handle them
numerical_cols_train = [c for c in train_df.columns if train_df[c].dtype != 'object' and c != 'target']
categorical_cols_train = [c for c in train_df.columns if train_df[c].dtype == 'object' and c != 'target']

numerical_cols_test = [c for c in test_df.columns if test_df[c].dtype != 'object']
categorical_cols_test = [c for c in test_df.columns if test_df[c].dtype == 'object']

# Impute missing values
imputer_num_train = SimpleImputer(strategy='median')
train_df[numerical_cols_train] = imputer_num_train.fit_transform(train_df[numerical_cols_train])

imputer_cat_train = SimpleImputer(strategy='most_frequent')
train_df[categorical_cols_train] = imputer_cat_train.fit_transform(train_df[categorical_cols_train])

imputer_num_test = SimpleImputer(strategy='median')
test_df[numerical_cols_test] = imputer_num_test.fit_transform(test_df[numerical_cols_test])

imputer_cat_test = SimpleImputer(strategy='most_frequent')
test_df[categorical_cols_test] = imputer_cat_test.fit_transform(test_df[categorical_cols_test])

# Ensure data types are correct and consistent
train_df[numerical_cols_train] = train_df[numerical_cols_train].astype(float)
test_df[numerical_cols_test] = test_df[numerical_cols_test].astype(float)

# Handle high-cardinality categorical columns
for col in categorical_cols_train:
    if train_df[col].nunique() > 50:
        le = LabelEncoder()
        train_df[col] = le.fit_transform(train_df[col])
        test_df[col] = le.transform(test_df[col])

# Standardize numerical features
scaler = StandardScaler()
train_df[numerical_cols_train] = scaler.fit_transform(train_df[numerical_cols_train])
test_df[numerical_cols_test] = scaler.transform(test_df[numerical_cols_test])

# Print shapes and memory usage after processing
print("Processed Train Shape:", train_df.shape)
print("Processed Test Shape:", test_df.shape)
print("Train Memory Usage After Processing:\n", train_df.memory_usage(deep=True))
print("Test Memory Usage After Processing:\n", test_df.memory_usage(deep=True))

# Save processed data back to the same files
train_df.to_csv('train.csv', index=False)
test_df.to_csv('test.csv', index=False)

print("Data processing complete. Files saved.")
