categorical_cols_train = [c for c in train_df.columns if train_df[c].dtype == 'object' and c != 'target']

numerical_cols_test = [c for c in test_df.columns if test_df[c].dtype != 'object']
categorical_cols_test = [c for c in test_df.columns if test_df[c].dtype == 'object']

# Impute missing values
imputer_num_train = SimpleImputer(strategy='median')
train_df[numerical_cols_train] = imputer_num_train.fit_transform(train_df[numerical_cols_train])

imputer_cat_train = SimpleImputer(strategy='most_frequent')
train_df[categorical_cols_train] = imputer_cat_train.fit_transform(train_df[categorical_cols_train])

imputer_num_test = SimpleImputer(strategy='median')
test_df[numerical_cols_test] = imputer_num_test.fit_transform(test_df[numerical_cols_test])

imputer_cat_test = SimpleImputer(strategy='most_frequent')
test_df[categorical_cols_test] = imputer_cat_test.fit_transform(test_df[categorical_cols_test])

# Ensure correct data types
train_df[numerical_cols_train] = train_df[numerical_cols_train].astype(float)
test_df[numerical_cols_test] = test_df[numerical_cols_test].astype(float)

# Feature engineering: extract useful features from datetime columns if any
