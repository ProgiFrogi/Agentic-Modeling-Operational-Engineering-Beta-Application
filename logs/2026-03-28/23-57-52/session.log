from sklearn.preprocessing import StandardScaler, LabelEncoder
from sklearn.impute import SimpleImputer

# Load data
train_df = pd.read_csv('train.csv')
test_df = pd.read_csv('test.csv')

# Print initial shapes and memory usage
print("Initial Train Shape:", train_df.shape)
print("Initial Test Shape:", test_df.shape)
print("Train Memory Usage:\n", train_df.memory_usage(deep=True))
print("Test Memory Usage:\n", test_df.memory_usage(deep=True))

# Identify target variable and features
target_col = 'target'
features_cols = [col for col in train_df.columns if col != target_col]

# Separate numerical and categorical columns
numerical_cols_train = [c for c in train_df.select_dtypes(include=['number']).columns if c != target_col]
categorical_cols_train = [c for c in train_df.select_dtypes(exclude=['number']).columns if c != target_col]

numerical_cols_test = [c for c in test_df.select_dtypes(include=['number']).columns]
categorical_cols_test = [c for c in test_df.select_dtypes(exclude=['number']).columns]

# Handle missing values
print("Handling Missing Values...")

# Numerical columns
imputer_num_train = SimpleImputer(strategy='median')
train_df[numerical_cols_train] = imputer_num_train.fit_transform(train_df[numerical_cols_train])

imputer_num_test = SimpleImputer(strategy='median')
test_df[numerical_cols_test] = imputer_num_test.fit_transform(test_df[numerical_cols_test])

# Categorical columns
imputer_cat_train = SimpleImputer(strategy='most_frequent')
train_df[categorical_cols_train] = imputer_cat_train.fit_transform(train_df[categorical_cols_train])

imputer_cat_test = SimpleImputer(strategy='most_frequent')
test_df[categorical_cols_test] = imputer_cat_test.fit_transform(test_df[categorical_cols_test])

# Print shapes and memory usage after handling missing values
print("Train Shape after Missing Value Handling:", train_df.shape)
print("Test Shape after Missing Value Handling:", test_df.shape)
print("Train Memory Usage after Missing Value Handling:\n", train_df.memory_usage(deep=True))
print("Test Memory Usage after Missing Value Handling:\n", test_df.memory_usage(deep=True))

# Handle outliers
print("Handling Outliers...")

# For simplicity, we will cap the values at 1.5*IQR for numerical columns
for col in numerical_cols_train:
    Q1 = train_df[col].quantile(0.25)
    Q3 = train_df[col].quantile(0.75)
    IQR = Q3 - Q1
    lower_bound = Q1 - 1.5 * IQR
    upper_bound = Q3 + 1.5 * IQR
    train_df[col] = train_df[col].clip(lower=lower_bound, upper=upper_bound)

for col in numerical_cols_test:
    Q1 = test_df[col].quantile(0.25)
    Q3 = test_df[col].quantile(0.75)
    IQR = Q3 - Q1
    lower_bound = Q1 - 1.5 * IQR
    upper_bound = Q3 + 1.5 * IQR
    test_df[col] = test_df[col].clip(lower=lower_bound, upper=upper_bound)

# Print shapes and memory usage after handling outliers
print("Train Shape after Outlier Handling:", train_df.shape)
print("Test Shape after Outlier Handling:", test_df.shape)
print("Train Memory Usage after Outlier Handling:\n", train_df.memory_usage(deep=True))
print("Test Memory Usage after Outlier Handling:\n", test_df.memory_usage(deep=True))

# Feature engineering
print("Performing Feature Engineering...")

# For datetime columns, extract useful features (year, month, day, dayofweek)
for col in train_df.select_dtypes(include=['datetime64']).columns:
    train_df[col + '_year'] = train_df[col].dt.year
    train_df[col + '_month'] = train_df[col].dt.month
    train_df[col + '_day'] = train_df[col].dt.day
    train_df[col + '_dayofweek'] = train_df[col].dt.dayofweek

for col in test_df.select_dtypes(include=['datetime64']).columns:
    test_df[col + '_year'] = test_df[col].dt.year
    test_df[col + '_month'] = test_df[col].dt.month
    test_df[col + '_day'] = test_df[col].dt.day
    test_df[col + '_dayofweek'] = test_df[col].dt.dayofweek

# Print shapes and memory usage after feature engineering
print("Train Shape after Feature Engineering:", train_df.shape)
print("Test Shape after Feature Engineering:", test_df.shape)
print("Train Memory Usage after Feature Engineering:\n", train_df.memory_usage(deep=True))
print("Test Memory Usage after Feature Engineering:\n", test_df.memory_usage(deep=True))

# Encoding categorical variables
print("Encoding Categorical Variables...")

label_encoders = {}
for col in categorical_cols_train:
    le = LabelEncoder()
    train_df[col] = le.fit_transform(train_df[col])
    label_encoders[col] = le

for col in categorical_cols_test:
    if col in label_encoders:
        test_df[col] = label_encoders[col].transform(test_df[col])

# Print shapes and memory usage after encoding
print("Train Shape after Encoding:", train_df.shape)
print("Test Shape after Encoding:", test_df.shape)
print("Train Memory Usage after Encoding:\n", train_df.memory_usage(deep=True))
print("Test Memory Usage after Encoding:\n", test_df.memory_usage(deep=True))

# Standardize numerical features
print("Standardizing Numerical Features...")

scaler = StandardScaler()
train_df[numerical_cols_train] = scaler.fit_transform(train_df[numerical_cols_train])
test_df[numerical_cols_test] = scaler.transform(test_df[numerical_cols_test])

# Print shapes and memory usage after standardization
print("Train Shape after Standardization:", train_df.shape)
print("Test Shape after Standardization:", test_df.shape)
print("Train Memory Usage after Standardization:\n", train_df.memory_usage(deep=True))
print("Test Memory Usage after Standardization:\n", test_df.memory_usage(deep=True))

# Save processed data back to the same files
train_df.to_csv('train.csv', index=False)
test_df.to_csv('test.csv', index=False)

print("Data processing complete. Files saved.")
