# 4. Check missing values
missing_values = df_train.isnull().sum() / len(df_train)
print(missing_values)

# Fill missing dates with median date of non-null values and create indicator column 'last_dt_na'
median_last_dt = pd.to_datetime(df_train['last_dt']).dropna().median()
df_train['last_dt'] = df_train['last_dt'].fillna(str(median_last_dt))
df_train['last_dt_na'] = df_train['last_dt'].isnull().astype(int)

# Fill missing values with median avg_reviews and create indicator column 'avg_reviews_na'
median_avg_reviews = df_train['avg_reviews'].dropna().median()
df_train['avg_reviews'] = df_train['avg_reviews'].fillna(median_avg_reviews)
df_train['avg_reviews_na'] = df_train['avg_reviews'].isnull().astype(int)

# 5. Convert 'last_dt' to datetime (where not NA), extract features
df_train['last_dt'] = pd.to_datetime(df_train['last_dt'])
df_train['year'] = df_train['last_dt'].dt.year
df_train['month'] = df_train['last_dt'].dt.month
df_train['day'] = df_train['last_dt'].dt.day
df_train['is_weekend'] = (df_train['last_dt'].dt.weekday >= 5).astype(int)
df_train['is_friday'] = (df_train['last_dt'].dt.weekday == 4).astype(int)
df_train['last_30_days'] = ((df_train['last_dt'] - pd.Timestamp.now()) < pd.Timedelta(days=30)).astype(int)

# 6. Outlier detection
Q1_sum = df_train['sum'].quantile(0.25)
Q3_sum = df_train['sum'].quantile(0.75)
IQR_sum = Q3_sum - Q1_sum
df_train['sum'] = np.where((df_train['sum'] < (Q1_sum - 2 * IQR_sum)) | (df_train['sum'] > (Q3_sum + 2 * IQR_sum)),
                           df_train['sum'].median(), df_train['sum'])

df_train['min_days'] = np.where(df_train['min_days'] > 30, 30,
                              np.where(df_train['min_days'] < 1, 1, df_train['min_days']))

# 7. Feature engineering
df_train['price_per_day'] = df_train['sum'] / df_train['min_days']
