from sklearn.preprocessing import StandardScaler, LabelEncoder
from sklearn.impute import SimpleImputer

# Load data
train_df = pd.read_csv('train.csv')
test_df = pd.read_csv('test.csv')

# Print initial shapes and memory usage
print("Initial Train Shape:", train_df.shape)
print("Initial Test Shape:", test_df.shape)
print("Train Memory Usage:\n", train_df.memory_usage(deep=True))
print("Test Memory Usage:\n", test_df.memory_usage(deep=True))

# Identify target variable
target_col = 'target'
numerical_cols_train = [c for c in train_df.columns if train_df[c].dtype != 'object' and c != target_col]
categorical_cols_train = [c for c in train_df.columns if train_df[c].dtype == 'object']

# Handle missing values in train data
num_imputer = SimpleImputer(strategy='median')
cat_imputer = SimpleImputer(strategy='most_frequent')

train_df[numerical_cols_train] = num_imputer.fit_transform(train_df[numerical_cols_train])
train_df[categorical_cols_train] = cat_imputer.fit_transform(train_df[categorical_cols_train])

# Handle missing values in test data
numerical_cols_test = [c for c in test_df.columns if test_df[c].dtype != 'object']
categorical_cols_test = [c for c in test_df.columns if test_df[c].dtype == 'object']

test_df[numerical_cols_test] = num_imputer.transform(test_df[numerical_cols_test])
test_df[categorical_cols_test] = cat_imputer.transform(test_df[categorical_cols_test])

# Encode categorical columns
label_encoders = {}
for col in categorical_cols_train:
    le = LabelEncoder()
    train_df[col] = le.fit_transform(train_df[col])
    label_encoders[col] = le

for col in categorical_cols_test:
    train_df[col] = label_encoders[col].transform(test_df[col])

# Standardize numerical columns
scaler = StandardScaler()
train_df[numerical_cols_train] = scaler.fit_transform(train_df[numerical_cols_train])
test_df[numerical_cols_test] = scaler.transform(test_df[numerical_cols_test])

# Print shapes and memory usage after transformations
print("Processed Train Shape:", train_df.shape)
print("Processed Test Shape:", test_df.shape)
print("Train Memory Usage:\n", train_df.memory_usage(deep=True))
print("Test Memory Usage:\n", test_df.memory_usage(deep=True))

# Save processed data back to files
train_df.to_csv('train.csv', index=False)
test_df.to_csv('test.csv', index=False)

print("Data processing complete and saved.")
